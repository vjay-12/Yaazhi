{
  "name": "yaazhi",
  "description": "Boutique Inventory Management & Billing Platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,magenta\" \"tsx watch backend/src/dev.ts\" \"vite --host\"",
    "dev:web": "vite --host",
    "server": "tsx watch backend/src/dev.ts",
    "dev:all": "concurrently -n \"api,web\" -c \"blue,magenta\" \"tsx watch backend/src/dev.ts\" \"vite --host\"",
    "build": "tsc -b && vite build",
    "test": "tsx backend/src/test_stock_ledger_audit.ts && tsx backend/src/test_workflows.ts && tsx backend/src/test_product_lifecycle.ts && tsx backend/src/test_catalog_integrity.ts && tsx backend/src/test_customer_measurements.ts",
    "test:audit": "tsx backend/src/test_stock_ledger_audit.ts",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:push:neon": "tsx scripts/migrate-to-neon.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
