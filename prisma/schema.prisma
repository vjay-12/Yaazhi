generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompanySettings {
  id           String   @id @default("yaazhi_settings")
  company_name String   @default("Yaazhi Boutique & Atelier")
  legal_name   String?  @default("Yaazhi Silks & Couture Pvt Ltd")
  phone        String?  @default("+91 94440 12890")
  email        String?  @default("atelier@yaazhi.in")
  address      String?  @default("42 Weaver Colony, Kanchipuram")
  state_code   String?  @default("33") // Tamil Nadu
  gstin        String?  @default("33AABCY1234A1Z5")
  enable_gst   Boolean  @default(true)
  upi_id       String?  @default("yaazhi@oksbi")
  upi_qr_url   String?  @default("/images/payment/yaazhi-upi-qr.png")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("company_settings")
}

model Godown {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  address         String?
  state_code      String?
  gstin           String?
  is_default      Boolean           @default(false)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  
  stock_balances  StockBalance[]
  stock_movements StockMovement[]
  purchase_orders PurchaseOrder[]
  sales_orders    SalesOrder[]
  invoices        Invoice[]
  adjustments     StockAdjustment[]

  @@map("godowns")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  products    Product[]

  @@map("product_categories")
}

model Product {
  id               String                @id @default(uuid())
  sku              String                @unique
  name             String
  description      String?
  fabric           String?
  craft            String?
  category_id      String?
  unit             String                @default("PCS")
  sale_price       Decimal               @default(0) @db.Decimal(12, 2)
  purchase_price   Decimal               @default(0) @db.Decimal(12, 2)
  hsn_code         String?
  tax_rate         Decimal               @default(0) @db.Decimal(5, 2)
  min_stock_level  Decimal               @default(0) @db.Decimal(12, 2)
  image_url        String?
  is_active        Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  category         ProductCategory?      @relation(fields: [category_id], references: [id])
  stock_balances   StockBalance[]
  stock_movements  StockMovement[]
  purchase_items   PurchaseOrderItem[]
  sales_items      SalesOrderItem[]
  adjustment_items StockAdjustmentItem[]

  @@map("products")
}

model StockBalance {
  id               String   @id @default(uuid())
  product_id       String
  godown_id        String
  current_quantity Decimal  @default(0) @db.Decimal(12, 2)
  avg_cost         Decimal  @default(0) @db.Decimal(12, 2)
  updated_at       DateTime @updatedAt

  godown           Godown   @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, godown_id])
  @@index([godown_id])
  @@map("stock_balances")
}

enum MovementType {
  PURCHASE_RECEIPT
  SALES_DELIVERY
  ADJUSTMENT_ADD
  ADJUSTMENT_REDUCE
  RETURN_IN
  RETURN_OUT
}

model StockMovement {
  id             String       @id @default(uuid())
  movement_type  MovementType
  product_id     String
  godown_id      String
  quantity       Decimal      @db.Decimal(12, 2)
  unit_cost      Decimal      @default(0) @db.Decimal(12, 2)
  balance_after  Decimal      @db.Decimal(12, 2)
  reference_type String
  reference_id   String
  notes          String?
  created_at     DateTime     @default(now())
  created_by     String?

  godown         Godown       @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, godown_id])
  @@index([movement_type])
  @@index([reference_id])
  @@map("stock_movements")
}

model Supplier {
  id              String          @id @default(uuid())
  name            String
  contact_person  String?
  category        String?
  vendor_type     String?
  notes           String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  state_code      String?
  gstin           String?
  bank_name       String?
  account_number  String?
  ifsc_code       String?
  upi_id          String?
  opening_balance Decimal         @default(0) @db.Decimal(12, 2)
  is_active       Boolean         @default(true)
  is_archived     Boolean         @default(false)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  purchase_orders PurchaseOrder[]
  payments        Payment[]

  @@map("suppliers")
}

model Customer {
  id                   String                        @id @default(uuid())
  name                 String
  phone                String?
  email                String?
  address              String?
  city                 String?
  state_code           String?
  gstin                String?
  shipping_address     String?
  notes                String?
  is_archived          Boolean                       @default(false)
  created_at           DateTime                      @default(now())
  updated_at           DateTime                      @updatedAt

  sales_orders         SalesOrder[]
  invoices             Invoice[]
  payments             Payment[]
  measurement_profiles CustomerMeasurementProfile[]

  @@map("customers")
}

enum POStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  po_number        String              @unique
  supplier_id      String?
  supplier_name    String
  supplier_phone   String?
  supplier_address String?
  supplier_gstin   String?
  godown_id        String
  order_date       DateTime            @default(now())
  expected_date    DateTime?
  status           POStatus            @default(ORDERED)
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  tax_total        Decimal             @default(0) @db.Decimal(12, 2)
  grand_total      Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  created_by       String?

  godown           Godown              @relation(fields: [godown_id], references: [id])
  supplier         Supplier?           @relation(fields: [supplier_id], references: [id])
  items            PurchaseOrderItem[]

  @@index([supplier_id])
  @@index([godown_id])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchase_order_id String
  product_id        String
  quantity          Decimal       @db.Decimal(12, 2)
  unit_cost         Decimal       @db.Decimal(12, 2)
  tax_rate          Decimal       @default(0) @db.Decimal(5, 2)
  tax_amount        Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)

  product           Product       @relation(fields: [product_id], references: [id])
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
  VOIDED
}

model SalesOrder {
  id               String           @id @default(uuid())
  order_number     String           @unique
  customer_id      String?
  customer_name    String
  customer_phone   String?
  customer_address String?
  customer_gstin   String?
  godown_id        String
  order_date       DateTime         @default(now())
  status           OrderStatus      @default(CONFIRMED)
  subtotal         Decimal          @default(0) @db.Decimal(12, 2)
  discount_total   Decimal          @default(0) @db.Decimal(12, 2)
  tax_total        Decimal          @default(0) @db.Decimal(12, 2)
  grand_total      Decimal          @default(0) @db.Decimal(12, 2)
  paid_amount      Decimal          @default(0) @db.Decimal(12, 2)
  pending_amount   Decimal          @default(0) @db.Decimal(12, 2)
  payment_status   String           @default("PAID") // PAID, PARTIAL, PENDING
  notes            String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String?

  customer         Customer?        @relation(fields: [customer_id], references: [id])
  godown           Godown           @relation(fields: [godown_id], references: [id])
  items            SalesOrderItem[]
  invoices         Invoice[]
  payments         Payment[]

  @@index([customer_id])
  @@index([godown_id])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String     @id @default(uuid())
  sales_order_id String
  product_id     String
  quantity       Decimal    @db.Decimal(12, 2)
  unit_price     Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  tax_rate       Decimal    @default(0) @db.Decimal(5, 2)
  tax_amount     Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)

  product        Product    @relation(fields: [product_id], references: [id])
  sales_order    SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model Invoice {
  id                 String      @id @default(uuid())
  invoice_number     String      @unique
  invoice_type       String      @default("TAX_INVOICE")
  reference_order_id String?
  customer_id        String?
  godown_id          String
  invoice_date       DateTime    @default(now())
  due_date           DateTime?
  status             String      @default("PAID") // PAID, UNPAID, PARTIAL, VOID
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  discount_total     Decimal     @default(0) @db.Decimal(12, 2)
  tax_total          Decimal     @default(0) @db.Decimal(12, 2)
  grand_total        Decimal     @default(0) @db.Decimal(12, 2)
  paid_amount        Decimal     @default(0) @db.Decimal(12, 2)
  balance_amount     Decimal     @default(0) @db.Decimal(12, 2)
  created_at         DateTime    @default(now())

  customer           Customer?   @relation(fields: [customer_id], references: [id])
  godown             Godown      @relation(fields: [godown_id], references: [id])
  sales_order        SalesOrder? @relation(fields: [reference_order_id], references: [id])
  payments           Payment[]

  @@map("invoices")
}

model Payment {
  id               String      @id @default(uuid())
  payment_number   String      @unique
  invoice_id       String?
  sales_order_id   String?
  customer_id      String?
  supplier_id      String?
  payment_date     DateTime    @default(now())
  amount           Decimal     @db.Decimal(12, 2)
  payment_mode     String      @default("CASH") // CASH, CARD, UPI, BANK_TRANSFER
  status           String      @default("SUCCESSFUL") // SUCCESSFUL, PENDING, FAILED
  reference_number String?
  notes            String?
  created_at       DateTime    @default(now())

  customer         Customer?   @relation(fields: [customer_id], references: [id])
  invoice          Invoice?    @relation(fields: [invoice_id], references: [id])
  sales_order      SalesOrder? @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  supplier         Supplier?   @relation(fields: [supplier_id], references: [id])

  @@index([sales_order_id])
  @@map("payments")
}

model StockAdjustment {
  id                String                @id @default(uuid())
  adjustment_number String                @unique
  godown_id         String
  reason            String
  status            String                @default("APPLIED")
  notes             String?
  created_at        DateTime              @default(now())
  created_by        String?

  godown            Godown                @relation(fields: [godown_id], references: [id])
  items             StockAdjustmentItem[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id            String          @id @default(uuid())
  adjustment_id String
  product_id    String
  system_qty    Decimal         @db.Decimal(12, 2)
  counted_qty   Decimal         @db.Decimal(12, 2)
  diff_qty      Decimal         @db.Decimal(12, 2)
  unit_cost     Decimal         @default(0) @db.Decimal(12, 2)

  adjustment    StockAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [product_id], references: [id])

  @@map("stock_adjustment_items")
}

// Boutique Tailoring Measurements
model MeasurementTemplate {
  id          String                      @id @default(uuid())
  name        String
  code        String                      @unique
  description String?
  category    String                      @default("WOMEN")
  is_default  Boolean                     @default(false)
  is_active   Boolean                     @default(true)
  created_at  DateTime                    @default(now())
  updated_at  DateTime                    @updatedAt

  fields      MeasurementTemplateField[]
  profiles    CustomerMeasurementProfile[]

  @@map("measurement_templates")
}

model MeasurementTemplateField {
  id            String                    @id @default(uuid())
  template_id   String
  field_key     String
  field_name    String
  field_type    String                    @default("number")
  default_unit  String                    @default("in")
  display_order Int                       @default(0)
  is_required   Boolean                   @default(false)
  is_active     Boolean                   @default(true)
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  template      MeasurementTemplate       @relation(fields: [template_id], references: [id], onDelete: Cascade)
  values        CustomerMeasurementValue[]

  @@unique([template_id, field_key])
  @@index([template_id, display_order])
  @@map("measurement_template_fields")
}

model CustomerMeasurementProfile {
  id            String                      @id @default(uuid())
  customer_id   String
  template_id   String
  profile_name  String
  notes         String?
  is_active     Boolean                     @default(true)
  created_at    DateTime                    @default(now())
  updated_at    DateTime                    @updatedAt

  customer      Customer                    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  template      MeasurementTemplate         @relation(fields: [template_id], references: [id], onDelete: Restrict)
  versions      CustomerMeasurementVersion[]

  @@index([customer_id])
  @@index([template_id])
  @@map("customer_measurement_profiles")
}

model CustomerMeasurementVersion {
  id             String                      @id @default(uuid())
  profile_id     String
  version_number Int                         @default(1)
  measured_at    DateTime                    @default(now())
  measured_by    String?
  notes          String?
  is_current     Boolean                     @default(true)
  created_at     DateTime                    @default(now())

  profile        CustomerMeasurementProfile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  values         CustomerMeasurementValue[]

  @@index([profile_id, is_current])
  @@index([profile_id, version_number])
  @@map("customer_measurement_versions")
}

model CustomerMeasurementValue {
  id            String                     @id @default(uuid())
  version_id    String
  field_id      String
  numeric_value Decimal?                   @db.Decimal(8, 2)
  text_value    String?
  unit          String                     @default("in")
  notes         String?
  created_at    DateTime                   @default(now())

  version       CustomerMeasurementVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  field         MeasurementTemplateField   @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([version_id, field_id])
  @@index([version_id])
  @@index([field_id])
  @@map("customer_measurement_values")
}
